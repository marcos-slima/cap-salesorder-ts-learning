/**
 * ═══════════════════════════════════════════════════════════════════
 *  FILE  : db/aspects/domain-aspects.cds
 *  LAYER : Domain Model — Reusable Aspects (Mixins)
 *
 *  CAP aspects are the CDS equivalent of DDD mixins / traits.
 *  They reduce repetition and enforce consistent annotation
 *  patterns across all entities that share a behaviour.
 *
 *  Aspect catalogue
 *  ────────────────
 *  SoftDeletable   — logical deletion via DeletionIndicator flag
 *  Monetized       — monetary amount + ISO currency pair
 *  Quantified      — decimal quantity + unit of measure pair
 *  BusinessKeyed   — separates UUID surrogate key from business key
 *  StatusTracked   — overall / delivery / billing status triple
 *  EventEmitting   — metadata needed for SAP Event Mesh emission
 *
 *  Usage example
 *  ─────────────
 *  entity MyEntity : managed, cuid, SoftDeletable, Monetized { … }
 * ═══════════════════════════════════════════════════════════════════
 */

namespace com.my.sales;

using { Currency, managed, cuid }    from '@sap/cds/common';
using { com.my.sales.DeletionIndicator,
        com.my.sales.OverallOrderStatus,
        com.my.sales.DeliveryStatus,
        com.my.sales.BillingStatus,
        com.my.sales.UnitOfMeasure }  from '../types/common-types';


// ─── SoftDeletable ────────────────────────────────────────────────
/**
 * Provides logical delete semantics.
 * CAP handlers should filter `deletionIndicator = ' '` in all
 * read projections and block hard-DELETE at service level.
 */
aspect SoftDeletable {
    /**
     * @UI.Hidden prevents the field from appearing in auto-generated
     * Fiori forms.  The field is still readable via $filter.
     */
    @UI.Hidden
    deletionIndicator : DeletionIndicator default ' ';
}


// ─── Monetized ───────────────────────────────────────────────────
/**
 * Amount + ISO currency pair.
 *
 * The @Measures.ISOCurrency annotation is placed on the amount
 * field pointing to the companion currency code field.  This
 * pattern is required by:
 *   • SAP Fiori Elements — renders a currency symbol next to the
 *     amount in tables and forms automatically.
 *   • OData v4 metadata — declares the currency unit dependency
 *     so clients can format the value without extra logic.
 *
 * Naming convention follows CAP default association expansion:
 *   currency        → association to sap.common.Currencies
 *   currency_code   → the FK column (String(3)) generated by CAP
 *
 * Extend with a field name prefix when multiple amounts exist:
 *   aspect NetPriced {
 *       @Measures.ISOCurrency: netCurrency_code
 *       netAmount    : Decimal(15,2);
 *       netCurrency  : Currency;
 *   }
 */
aspect Monetized {
    @Measures.ISOCurrency: currency_code
    amount      : Decimal(15, 2);
    currency    : Currency;
}


// ─── Quantified ──────────────────────────────────────────────────
/**
 * Decimal quantity + ISO unit of measure code.
 *
 * @Measures.Unit annotation on quantity points to the UoM field
 * so that Fiori renders "10 EA" instead of two separate columns.
 *
 * Same multi-field extension pattern as Monetized applies here.
 */
aspect Quantified {
    @Measures.Unit: quantityUnit
    quantity        : Decimal(13, 3);
    quantityUnit    : UnitOfMeasure;
}


// ─── StatusTracked ────────────────────────────────────────────────
/**
 * SAP-standard status triple for sales documents (mirrors VBUK).
 *
 * All three fields are READ-ONLY at the service layer — they are
 * computed by domain handlers on every WRITE operation.
 * Marking them @readonly at the model level prevents OData PATCH
 * requests from overwriting them directly.
 *
 * @Core.Computed signals to Fiori Elements that the field is
 * server-calculated and should not be presented as editable.
 */
aspect StatusTracked {
    @readonly
    @Core.Computed
    overallStatus   : OverallOrderStatus  default 'A';

    @readonly
    @Core.Computed
    deliveryStatus  : DeliveryStatus      default 'A';

    @readonly
    @Core.Computed
    billingStatus   : BillingStatus       default 'A';
}


// ─── EventEmitting ───────────────────────────────────────────────
/**
 * Metadata fields required to publish domain events to
 * SAP Event Mesh via the CAP Outbox pattern.
 *
 * How it works
 * ─────────────
 * 1. After every committed write, a CAP after-handler reads
 *    these fields and publishes a CloudEvent to Event Mesh.
 * 2. The `lastEventType` records which event was last emitted
 *    so that idempotent consumers can detect replays.
 * 3. `lastEventAt` allows the Event Mesh dead-letter monitor
 *    to identify stale events.
 *
 * CloudEvent type naming convention (SAP standard):
 *   com.my.sales.<aggregate>.<verb>.<version>
 *   e.g. com.my.sales.salesorder.created.v1
 */
aspect EventEmitting {
    @UI.Hidden
    @readonly
    lastEventType   : String(100);  // e.g. com.my.sales.salesorder.created.v1

    @UI.Hidden
    @readonly
    lastEventAt     : Timestamp;
}
