## ═══════════════════════════════════════════════════════════════════
##  FILE  : mta.yaml
##  MTA descriptor for SAP BTP deployment
##
##  Modules
##  ───────
##  cap-salesorder-ts-srv  CAP Node.js application (CF runtime)
##
##  Resources (BTP service instances)
##  ──────────────────────────────────
##  cap-salesorder-db       SAP HANA Cloud (managed)
##  cap-salesorder-auth     XSUAA (application plan)
##  cap-salesorder-em       SAP Event Mesh (standard plan)
##  cap-salesorder-conn     SAP Connectivity service
##
##  Build & deploy
##  ──────────────
##  mbt build              → produces mta_archives/cap-salesorder-ts_1.0.0.mtar
##  cf deploy mta_archives/cap-salesorder-ts_1.0.0.mtar --strategy blue-green
## ═══════════════════════════════════════════════════════════════════

_schema-version: '3.1'
ID: cap-salesorder-ts
version: 1.0.0
description: SAP CAP Sales Order domain — TypeScript reference implementation

parameters:
  enable-parallel-deployments: true

## ─── Build parameters ────────────────────────────────────────────

build-parameters:
  before-all:
    - builder: custom
      commands:
        - npm ci --production=false
        - npm run build

## ─── Modules ──────────────────────────────────────────────────────

modules:

  # ── CAP Node.js application ──────────────────────────────────────
  - name: cap-salesorder-ts-srv
    type: nodejs
    path: gen/srv

    parameters:
      buildpack: nodejs_buildpack
      readiness-health-check-type: http
      readiness-health-check-http-endpoint: /health

    build-parameters:
      builder: npm

    provides:
      - name: srv-api
        properties:
          srv-url: ${default-url}

    requires:
      - name: cap-salesorder-db
      - name: cap-salesorder-auth
      - name: cap-salesorder-em
      - name: cap-salesorder-conn
      - name: mtx-api # URL interna do sidecar MTX
        properties:
          CDS_MTX_SIDECAR_URL: ~{mtx-url}

    properties:
      # Enable structured JSON logging for Cloud Logging integration
      SAP_CDS_LOG_FORMAT: json
      NODE_ENV: production

  # ── MTX Sidecar — Multi-Tenancy eXtension service ────────────────
  #
  # Responsabilidades:
  #   • Onboarding de novos tenants (cria HDI Container por tenant)
  #   • Offboarding (remove dados e HDI Container do tenant)
  #   • Upgrade de schema após novos deploys (migration por tenant)
  #   • Extensibilidade: aceita campos customizados por tenant
  #
  # Comunicação com a aplicação principal:
  #   A app (cap-salesorder-ts-srv) conecta ao sidecar via
  #   cds.connect.to('cds.xt.ModelProviderService') usando a
  #   URL interna do CF (srv-api da rota provides abaixo).
  #
  # Refs:
  #   https://cap.cloud.sap/docs/guides/multitenancy/mtxs#deployment
  - name: cap-salesorder-ts-mtx
    type: nodejs
    path: gen/srv

    parameters:
      buildpack: nodejs_buildpack
      memory: 256M

    build-parameters:
      builder: npm

    provides:
      - name: mtx-api
        properties:
          mtx-url: ${default-url}

    requires:
      - name: cap-salesorder-db
      - name: cap-salesorder-auth
      - name: cap-salesorder-sm # Service Manager (HDI por tenant)

    properties:
      # Indica ao @sap/cds-mtxs que este processo é o sidecar
      CDS_MTX_SIDECAR: true
      NODE_ENV: production

  # ── Database deployer ─────────────────────────────────────────────
  - name: cap-salesorder-ts-db-deployer
    type: hdb
    path: gen/db

    parameters:
      buildpack: nodejs_buildpack

    build-parameters:
      builder: npm

    requires:
      - name: cap-salesorder-db

## ─── Resources (BTP service instances) ───────────────────────────

resources:

  # ── HANA Cloud (managed service — schema per tenant) ─────────────
  - name: cap-salesorder-db
    type: com.sap.xs.hdi-container
    parameters:
      service: hana
      service-plan: hdi-shared
    properties:
      hdi-service-name: ${service-name}

  # ── XSUAA — authentication and authorisation ─────────────────────
  - name: cap-salesorder-auth
    type: org.cloudfoundry.managed-service
    parameters:
      service: xsuaa
      service-plan: application
      path: ./xs-security.json
      config:
        xsappname: cap-salesorder-ts-${org}-${space}
        tenant-mode: shared
        # Service-level OAuth scopes consumed by CAP
        oauth2-configuration:
          token-validity: 43200 # 12 hours
          refresh-validity: 86400 # 24 hours

  # ── SAP Event Mesh — domain event publishing ──────────────────────
  - name: cap-salesorder-em
    type: org.cloudfoundry.managed-service
    parameters:
      service: enterprise-messaging
      service-plan: default
      path: ./em-config.json # topic namespace + queue configuration

  # ── SAP Connectivity service — on-prem / private cloud systems ───
  - name: cap-salesorder-conn
    type: org.cloudfoundry.managed-service
    parameters:
      service: connectivity
      service-plan: lite

  # ── SAP Service Manager — HDI Container por tenant (multitenancy) ─
  #
  # O Service Manager provisiona um HDI Container HANA independente
  # para cada tenant no onboarding.  Requer HANA Cloud configurado.
  # Plan `container` reserva capacidade por tenant automaticamente.
  # Refs: https://help.sap.com/docs/service-manager
  - name: cap-salesorder-sm
    type: org.cloudfoundry.managed-service
    parameters:
      service: service-manager
      service-plan: container
