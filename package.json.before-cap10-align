{
  "name": "cap-salesorder-ts",
  "version": "1.0.0",
  "private": true,
  "description": "SAP CAP Sales Order domain — TypeScript reference implementation",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "cds-serve",
    "dev": "cds watch",
    "dev:mtx": "cds watch --port 4005 srv/mtx/sidecar.ts",
    "build": "cds build --production",
    "typecheck": "tsc --noEmit",
    "test": "jest --config jest.config.js --forceExit --detectOpenHandles",
    "test:watch": "jest --config jest.config.js --watch",
    "typegen": "cds-typer '*' --outputDirectory @cds-models",
    "lint": "cds lint"
  },
  "dependencies": {
    "@cap-js/attachments": "^1",
    "@cap-js/audit-logging": "^1",
    "@cap-js/change-tracking": "^1",
    "@cap-js/hana": "^3.1.0",
    "@sap/cds": "^10.1.0",
    "@sap/xssec": "^4",
    "express": "^4"
  },
  "devDependencies": {
    "@cap-js/cds-test": "^0.4.1",
    "@cap-js/cds-typer": "^0.38.0",
    "@cap-js/cds-types": "^0.16.0",
    "@cap-js/sqlite": "^3.1.0",
    "@sap/cds-dk": "^9.8.3",
    "@types/jest": "^29",
    "@types/node": "^20",
    "jest": "^29",
    "ts-jest": "^29",
    "ts-node": "^10",
    "tsx": "^4.20.6",
    "typescript": "^5"
  },
  "overrides": {
    "axios": "^1.15.0"
  },
  "cds": {
    "typescript": true,
    "requires": {
      "db": {
        "[development]": {
          "kind": "sqlite",
          "credentials": {
            "url": "db/db.sqlite"
          }
        },
        "[test]": {
          "kind": "sqlite",
          "credentials": {
            "url": ":memory:"
          }
        },
        "[production]": {
          "kind": "hana",
          "deploy-format": "hdbtable"
        }
      },
      "auth": {
        "[development]": {
          "kind": "mocked",
          "users": {
            "alice": {
              "roles": [
                "SalesProcessor",
                "CatalogReader"
              ]
            },
            "bob": {
              "roles": [
                "SalesManager",
                "CatalogReader",
                "AnalyticsReader"
              ]
            },
            "charlie": {
              "roles": [
                "SalesAuditor",
                "CatalogReader",
                "AnalyticsReader"
              ]
            },
            "dave": {
              "roles": [
                "AnalyticsReader"
              ]
            }
          }
        },
        "[test]": {
          "kind": "mocked",
          "users": {
            "alice": {
              "roles": [
                "SalesProcessor",
                "CatalogReader"
              ]
            },
            "bob": {
              "roles": [
                "SalesManager",
                "CatalogReader",
                "AnalyticsReader"
              ]
            },
            "charlie": {
              "roles": [
                "SalesAuditor",
                "CatalogReader",
                "AnalyticsReader"
              ]
            },
            "carol": {
              "roles": [
                "CatalogReader"
              ]
            },
            "dave": {
              "roles": [
                "AnalyticsReader"
              ]
            }
          }
        },
        "[production]": {
          "kind": "xsuaa"
        }
      },
      "messaging": {
        "kind": "file-based-messaging",
        "publishPrefix": "com/my/sales/",
        "subscribePrefix": "+/",
        "[production]": {
          "kind": "enterprise-messaging-shared",
          "outbox": {
            "kind": "persistent-outbox"
          }
        }
      }
    }
  },
  "workspaces": [
    "app/*"
  ]
}
