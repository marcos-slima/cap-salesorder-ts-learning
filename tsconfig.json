{
  "compilerOptions": {
    // Target ES2022 — supported by Node 18+ and enables top-level await
    "target":  "ES2022",
    "module":  "Node16",
    "lib":     ["ES2022"],

    // Strict type-checking — required for production-quality TypeScript
    "strict":                       true,
    "noUnusedLocals":               true,
    "noUnusedParameters":           true,
    "noImplicitReturns":            true,
    "noFallthroughCasesInSwitch":   true,

    // Module resolution
    "moduleResolution":             "node16",
    "esModuleInterop":              true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule":            true,
    "skipLibCheck":                 true,

    // Output — used by `npm run build` for production
    "outDir":  "dist",
    "rootDir": ".",

    // Source maps — required for readable stack traces in BTP cloud logs
    "sourceMap":      true,
    "declaration":    true,
    "declarationMap": true,

    // Path aliases — @cds-models/* is generated by `npm run typegen`
    "paths": {
      "#cds-models/*": ["./@cds-models/*"]
    }
  },

  "include": ["srv/**/*", "test/**/*"],

  "exclude": [
    "node_modules",
    "dist",
    "@cds-models",
    "gen"
  ],

  // ts-node configuration — used by `cds watch` in development
  "ts-node": {
    "transpileOnly": true,
    "esm": false
  }
}
