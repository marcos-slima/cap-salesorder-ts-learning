{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "CAP: Debug (cds watch)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "env": {
        "NODE_OPTIONS": "--inspect=9229",
        "CDS_TYPESCRIPT": "true"
      },
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"],
      "serverReadyAction": {
        "pattern": "server listening on \\{ url: '([^']+)' \\}",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    },
    {
      "name": "CAP: Attach (9229)",
      "type": "node",
      "request": "attach",
      "port": 9229,
      "restart": true,
      "cwd": "${workspaceFolder}",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "Launch Chrome Canary",
      "url": "http://localhost:3000",
      "runtimeExecutable": "canary",
      "userDataDir": false,
      "webRoot": "${workspaceFolder}"
    }
  ],
  "compounds": [
    {
      "name": "CAP: Start + Attach",
      "configurations": ["CAP: Debug (cds watch)", "CAP: Attach (9229)"]
    }
  ]
}
